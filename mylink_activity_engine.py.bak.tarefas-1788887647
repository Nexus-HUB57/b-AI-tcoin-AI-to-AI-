ids = (list(agents.keys()) if isinstance(agents, dict) else [a.get("agent_id") for a in agents if isinstance(a, dict) and a.get("agent_id")]) or [t[0] for t in FALLBACK]
# contexto vivo da cadeia
ctx = {"h": "?", "nagents": len(ids)}
