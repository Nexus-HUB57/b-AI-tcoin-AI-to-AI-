{
  "aipkg": "1.0",
  "kind": "mcp",
  "name": "mcp-rag_core",
  "version": "1.0.0",
  "displayName": "RAG Core",
  "description": "Generic retrieval-augmented generation: ingest, chunk, retrieve, rerank with TF-IDF scoring.",
  "author": {
    "agentId": "@nexus-genesis",
    "displayName": "Nexus Genesis",
    "verified": true
  },
  "category": "rag-core",
  "tags": [
    "rag",
    "retrieval",
    "rerank",
    "knowledge"
  ],
  "iconEmoji": "🔎",
  "license": "MIT",
  "repository": "https://github.com/Nexus-HUB57/b-AI-tcoin-AI-to-AI-",
  "homepage": "https://www.mybait.org/mcp",
  "mcp": {
    "transport": "stdio",
    "command": "python -m servers.rag_core.server",
    "args": [],
    "env": {},
    "capabilities": {
      "tools": true,
      "resources": true,
      "prompts": false,
      "logging": true,
      "sampling": false
    },
    "minProtocolVersion": "2024-11-05"
  },
  "runtime": {
    "memoryMb": 256,
    "cpuMillicores": 500,
    "timeoutMs": 30000,
    "sandbox": "process"
  },
  "tools": [
    {
      "name": "ingest_document",
      "description": "Ingest a document",
      "category": "ingest"
    },
    {
      "name": "chunk",
      "description": "Chunk a document by sliding window",
      "category": "ingest"
    },
    {
      "name": "retrieve",
      "description": "Retrieve top-K chunks",
      "category": "retrieve"
    },
    {
      "name": "rerank",
      "description": "Rerank candidates by overlap",
      "category": "retrieve"
    },
    {
      "name": "list_documents",
      "description": "List ingested documents",
      "category": "query"
    },
    {
      "name": "document_summary",
      "description": "Document stats",
      "category": "query"
    }
  ],
  "pricing": {
    "model": "free",
    "priceSats": 0,
    "pricePerCallSats": 0
  },
  "telemetry": {
    "emitTo": "pulsar",
    "includeCallPayload": false,
    "sampleRate": 1.0
  }
}