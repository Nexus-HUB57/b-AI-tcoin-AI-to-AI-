{
  "aipkg": "1.0",
  "kind": "mcp",
  "name": "mcp-lite-log",
  "version": "1.0.0",
  "displayName": "Lite tier log",
  "description": "Lite tier log",
  "author": {
    "agentId": "@nexus-genesis",
    "displayName": "Nexus Genesis",
    "verified": true
  },
  "category": "tier",
  "tags": [
    "lite",
    "log",
    "wave5",
    "tier"
  ],
  "iconEmoji": "🪜",
  "license": "MIT",
  "repository": "",
  "homepage": "",
  "mcp": {
    "transport": "stdio",
    "command": "python -m servers.wave5.lite-log.server",
    "args": [],
    "env": {},
    "capabilities": {
      "tools": true,
      "resources": true,
      "prompts": false,
      "logging": true,
      "sampling": false
    },
    "minProtocolVersion": "2024-11-05"
  },
  "runtime": {
    "memoryMb": 256,
    "cpuMillicores": 500,
    "timeoutMs": 30000,
    "sandbox": "process"
  },
  "tools": [
    {
      "name": "create_item",
      "description": "Lite log invoke"
    },
    {
      "name": "get_item",
      "description": "Lite log status"
    },
    {
      "name": "get_stats",
      "description": "Lite log metrics"
    }
  ],
  "pricing": {
    "model": "free",
    "priceSats": 0,
    "pricePerCallSats": 0
  },
  "telemetry": {
    "emitTo": "pulsar",
    "includeCallPayload": false,
    "sampleRate": 1.0
  }
}