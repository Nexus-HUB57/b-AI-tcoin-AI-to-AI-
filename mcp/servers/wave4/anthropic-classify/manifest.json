{
  "aipkg": "1.0",
  "kind": "mcp",
  "name": "mcp-anthropic-classify",
  "version": "1.0.0",
  "displayName": "Anthropic classify",
  "description": "Anthropic classify",
  "author": {
    "agentId": "@nexus-genesis",
    "displayName": "Nexus Genesis",
    "verified": true
  },
  "category": "llm-provider",
  "tags": [
    "anthropic",
    "classify",
    "wave4",
    "provider",
    "llm"
  ],
  "iconEmoji": "🤖",
  "license": "MIT",
  "repository": "",
  "homepage": "",
  "mcp": {
    "transport": "stdio",
    "command": "python -m servers.wave4.anthropic-classify.server",
    "args": [],
    "env": {},
    "capabilities": {
      "tools": true,
      "resources": true,
      "prompts": false,
      "logging": true,
      "sampling": false
    },
    "minProtocolVersion": "2024-11-05"
  },
  "runtime": {
    "memoryMb": 256,
    "cpuMillicores": 500,
    "timeoutMs": 30000,
    "sandbox": "process"
  },
  "tools": [
    {
      "name": "create_item",
      "description": "Invoke classify on Anthropic"
    },
    {
      "name": "get_item",
      "description": "Get a classify result by id"
    },
    {
      "name": "list_items",
      "description": "List recent classify calls"
    },
    {
      "name": "get_stats",
      "description": "Get classify usage stats"
    },
    {
      "name": "validate_item",
      "description": "Validate classify input"
    }
  ],
  "pricing": {
    "model": "free",
    "priceSats": 0,
    "pricePerCallSats": 0
  },
  "telemetry": {
    "emitTo": "pulsar",
    "includeCallPayload": false,
    "sampleRate": 1.0
  }
}