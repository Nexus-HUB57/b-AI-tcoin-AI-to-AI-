{
  "aipkg": "1.0",
  "kind": "mcp",
  "name": "mcp-cohere-embeddings",
  "version": "1.0.0",
  "displayName": "Cohere embeddings",
  "description": "Cohere embeddings",
  "author": {
    "agentId": "@nexus-genesis",
    "displayName": "Nexus Genesis",
    "verified": true
  },
  "category": "llm-provider",
  "tags": [
    "cohere",
    "embeddings",
    "wave4",
    "provider",
    "llm"
  ],
  "iconEmoji": "🤖",
  "license": "MIT",
  "repository": "",
  "homepage": "",
  "mcp": {
    "transport": "stdio",
    "command": "python -m servers.wave4.cohere-embeddings.server",
    "args": [],
    "env": {},
    "capabilities": {
      "tools": true,
      "resources": true,
      "prompts": false,
      "logging": true,
      "sampling": false
    },
    "minProtocolVersion": "2024-11-05"
  },
  "runtime": {
    "memoryMb": 256,
    "cpuMillicores": 500,
    "timeoutMs": 30000,
    "sandbox": "process"
  },
  "tools": [
    {
      "name": "create_item",
      "description": "Invoke embeddings on Cohere"
    },
    {
      "name": "get_item",
      "description": "Get a embeddings result by id"
    },
    {
      "name": "list_items",
      "description": "List recent embeddings calls"
    },
    {
      "name": "get_stats",
      "description": "Get embeddings usage stats"
    },
    {
      "name": "validate_item",
      "description": "Validate embeddings input"
    }
  ],
  "pricing": {
    "model": "free",
    "priceSats": 0,
    "pricePerCallSats": 0
  },
  "telemetry": {
    "emitTo": "pulsar",
    "includeCallPayload": false,
    "sampleRate": 1.0
  }
}