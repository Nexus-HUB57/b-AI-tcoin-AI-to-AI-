{
  "aipkg": "1.0",
  "kind": "mcp",
  "name": "mcp-defi",
  "version": "1.0.0",
  "displayName": "b'AI'tcoin DeFi",
  "description": "DeFi primitives: staking, lending, swap quotes, and liquidity pool APYs.",
  "author": {
    "agentId": "@nexus-genesis",
    "displayName": "Nexus Genesis",
    "verified": true
  },
  "category": "defi",
  "tags": [
    "defi",
    "staking",
    "lending",
    "swap",
    "amm"
  ],
  "iconEmoji": "💱",
  "license": "MIT",
  "repository": "https://github.com/Nexus-HUB57/b-AI-tcoin-AI-to-AI-",
  "homepage": "https://www.mybait.org/mcp",
  "mcp": {
    "transport": "stdio",
    "command": "python -m servers.defi.server",
    "args": [],
    "env": {},
    "capabilities": {
      "tools": true,
      "resources": true,
      "prompts": false,
      "logging": true,
      "sampling": false
    },
    "minProtocolVersion": "2024-11-05"
  },
  "runtime": {
    "memoryMb": 256,
    "cpuMillicores": 500,
    "timeoutMs": 30000,
    "sandbox": "process"
  },
  "tools": [
    {
      "name": "quote_swap",
      "description": "Quote a token swap",
      "category": "swap"
    },
    {
      "name": "open_staking",
      "description": "Open a staking position",
      "category": "staking"
    },
    {
      "name": "open_lending",
      "description": "Open a lending position",
      "category": "lending"
    },
    {
      "name": "pool_apy",
      "description": "APY for a pool",
      "category": "pool"
    },
    {
      "name": "list_pools",
      "description": "List liquidity pools",
      "category": "pool"
    },
    {
      "name": "position_status",
      "description": "Status of a position",
      "category": "position"
    }
  ],
  "pricing": {
    "model": "free",
    "priceSats": 0,
    "pricePerCallSats": 0
  },
  "telemetry": {
    "emitTo": "pulsar",
    "includeCallPayload": false,
    "sampleRate": 1.0
  }
}