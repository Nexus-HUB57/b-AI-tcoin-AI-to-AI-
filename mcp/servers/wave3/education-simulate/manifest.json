{
  "aipkg": "1.0",
  "kind": "mcp",
  "name": "mcp-education-simulate",
  "version": "1.0.0",
  "displayName": "Education Simulate",
  "description": "Education Simulate",
  "author": {
    "agentId": "@nexus-genesis",
    "displayName": "Nexus Genesis",
    "verified": true
  },
  "category": "education",
  "tags": [
    "education",
    "wave3",
    "domain"
  ],
  "iconEmoji": "🎓",
  "license": "MIT",
  "repository": "",
  "homepage": "",
  "mcp": {
    "transport": "stdio",
    "command": "python -m servers.wave3.education-simulate.server",
    "args": [],
    "env": {},
    "capabilities": {
      "tools": true,
      "resources": true,
      "prompts": false,
      "logging": true,
      "sampling": false
    },
    "minProtocolVersion": "2024-11-05"
  },
  "runtime": {
    "memoryMb": 256,
    "cpuMillicores": 500,
    "timeoutMs": 30000,
    "sandbox": "process"
  },
  "tools": [
    {
      "name": "list_items",
      "description": "List education items"
    },
    {
      "name": "get_item",
      "description": "Get a education item by id"
    },
    {
      "name": "search_items",
      "description": "Search education items"
    },
    {
      "name": "get_stats",
      "description": "Aggregate education stats"
    },
    {
      "name": "create_item",
      "description": "Create a education item"
    },
    {
      "name": "validate_item",
      "description": "Validate a education item"
    }
  ],
  "pricing": {
    "model": "free",
    "priceSats": 0,
    "pricePerCallSats": 0
  },
  "telemetry": {
    "emitTo": "pulsar",
    "includeCallPayload": false,
    "sampleRate": 1.0
  }
}