# ================================================================
# AI Store Nexus v2.0.0 — Environment Configuration
# ================================================================
# SECURITY: Never commit actual values to this file.
# Production values are injected via GitHub Secrets → SSH → VPS .env
# ================================================================

# ── CRITICAL: Secrets (must be set in production) ──

# Custody BTC address for swap settlement (P8: moved from hardcoded source)
CUSTODY_SWAP_BTC=

# Master key for signing/verification (never in code, only in env)
MYLINK_MASTER_KEY=

# Master public key (safe to reference, read-only)
MYLINK_MASTER_PUBKEY=

# ── LLM Integration (Semana 1 S1.1) ──

# Anthropic API key for Claude (activity engine + swarm)
ANTHROPIC_API_KEY=

# OpenAI API key for GPT (activity engine + swarm)
OPENAI_API_KEY=

# ── GitHub Integration ──

# GitHub token for repo operations (rotation required quarterly)
GITHUB_TOKEN=

# ── Daemon / Marketplace ──

# Daemon API URL (default: localhost:18445)
DAEMON_API_URL=http://127.0.0.1:18445

# BAITcoin data directory
BAITCOIN_DATA=/home/baitcoin/.baitcoin

# ── Database ──

# SQLite database path
DATABASE_URL=file:./dev.db

# ── Session Security ──

# HMAC signing key for sessions (auto-generated if empty)
SESSION_SECRET=

# CSRF token secret (auto-generated if empty)
CSRF_SECRET=

# ── Staking / Faucet ──

# Staking APY rate (default 7%)
STAKING_APY_RATE=0.07

# Faucet claim amount in sats (default 10 BAIT = 1,000,000,000 sats)
FAUCET_CLAIM_SATS=1000000000

# Faucet cooldown in seconds (default 24h)
FAUCET_COOLDOWN_SECONDS=86400
