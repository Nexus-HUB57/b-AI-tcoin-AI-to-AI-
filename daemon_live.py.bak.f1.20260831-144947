def _do_POST(self):
    path = unquote(urlparse(self.path).path)
    if any(s == '..' for s in path.split('/')):
        self._j({'error': 'bad_path', 'path': path}, 400)
        return

    if path == "/api/v1/mylink/register":
        try:
            _ln = int(self.headers.get('Content-Length', 0) or 0)
            _pl = json.loads(self.rfile.read(_ln).decode("utf-8", "replace") or "{}") if 0 < _ln < 16384 else {}
        except Exception:
            _pl = {}
        _res, _code = _mylink_register(_pl)
        self._j(_res, _code); return
    if path == "/api/v1/mylink/profile":
        try:
            _ln = int(self.headers.get('Content-Length', 0) or 0)
            _pl = json.loads(self.rfile.read(_ln).decode("utf-8","replace") or "{}") if 0 < _ln < 32768 else {}
        except Exception:
            _pl = {}
        _res, _code = _mylink_profile_save(_pl)
        self._j(_res, _code); return
    if '/wallet/withdraw/broadcast' in path:
        try:
            _ln = int(self.headers.get('Content-Length', 0) or 0)
            _tx = json.loads(self.rfile.read(_ln).decode("utf-8", "replace") or "{}") if 0 < _ln < 65536 else {}
        except Exception:
            _tx = {}
        req = ["from_address","to_address","amount_bait","pubkey","sig","payload_hash"]
        if not all(k in _tx for k in req):
            self._j({'error':'campos_obrigatorios','required':req}, 400); return
        _okq, _msgq = _queue_broadcast(_tx)
        if _okq:
            self._j({'ok':True,'status':'queued_for_full_daemon','payload_hash':_tx.get('payload_hash'),
                     'note':'daemon leitura - TX assinada enfileirada; broadcast efetivo quando daemon completo assumir'}, 202)
        else:
            self._j({'ok':False,'error':_msgq}, 409)
        return
    if '/faucet/public-claim' in path or '/faucet/claim' in path:
        try:
            _body = self.rfile.read(int(self.headers.get('Content-Length', 0) or 0))
            _j = json.loads(_body) if _body else {}
        except Exception:
            _j = {}
        _aid = _j.get('agent_id', '')
        _addr = _j.get('address', '')
        if not _aid or not _addr:
            self._j({'error': 'missing_params', 'detail': 'agent_id e address obrigatorios'}, 400)
        else:
            _aid = _aid or (re.sub(r'[^A-Za-z0-9]','',_addr)[:10].lower()+'_auto')  # _v102f_aid
            _r = _faucet_claim(_aid, _addr)
            self._j(_r, 200 if _r.get('ok') else (429 if _r.get('error') == 'cooldown' else 400))
    else:
        self._j({'error': 'not_found', 'path': path}, 404)
