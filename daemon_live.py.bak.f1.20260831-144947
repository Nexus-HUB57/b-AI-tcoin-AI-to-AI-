_mylink_reg = "/home/baitcoin/.baitcoin/mylink_registrations.json"
def _mylink_register(payload):
    import re as _re, hashlib as _hl, time as _t, json as _j, os as _o
    aid = str(payload.get("agent_id", "")).strip()
    addr = str(payload.get("address", "")).strip()
    if not _re.match(r"^[A-Za-z0-9_-]{3,32}$", aid):
        return {"ok": False, "error": "agent_id_invalido"}, 400
    if not addr.startswith("b'/t"):
        return {"ok": False, "error": "endereco_invalido_formato_b/t"}, 400
    try: db = _j.load(open(_mylink_reg))
    except Exception: db = {"agents": {}}
    ags = db.setdefault("agents", {})
    if aid in ags: return {"ok": False, "error": "agent_id_ja_registrado"}, 409
    idhash = _hl.sha256((aid + addr + str(_t.time())).encode()).hexdigest()
    ags[aid] = {"agent_id": aid, "address": addr, "identity_hash": idhash,
                "skills": payload.get("skills", []), "bio": str(payload.get("bio", ""))[:280],
                "registered_at": _t.time(), "status": "pending_onchain_anchor"}
    _o.makedirs(_o.path.dirname(_mylink_reg), exist_ok=True)
    _j.dump(db, open(_mylink_reg, "w"))
    return {"ok": True, "agent_id": aid, "identity_hash": idhash, "status": "pending_onchain_anchor"}, 201



_mylink_profiles = "/home/baitcoin/.baitcoin/mylink_profiles.json"
def _mylink_profile_save(payload):
    """Fase 3 - perfil off-chain; apenas o hash de integridade e ancorado on-chain."""
    import hashlib as _hl, time as _t, json as _j, os as _o
    aid = str(payload.get("agent_id","")).strip()
    if not aid: return {"ok": False, "error": "agent_id_obrigatorio"}, 400
    try: reg = _j.load(open("/home/baitcoin/.baitcoin/mylink_registrations.json"))
    except Exception: reg = {"agents": {}}
    if aid not in reg.get("agents", {}):
        return {"ok": False, "error": "agente_nao_registrado_registre_primeiro"}, 404
    body = {"agent_id": aid,
            "headline": str(payload.get("headline",""))[:120],
            "bio": str(payload.get("bio",""))[:500],
            "skills": payload.get("skills", [])[:20],
            "portfolio": payload.get("portfolio", [])[:10],
            "rates_bait": payload.get("rates_bait"),
            "updated_at": _t.time()}
    canon = _j.dumps(body, sort_keys=True, separators=(",",":"))
    body["integrity_hash"] = _hl.sha256(canon.encode()).hexdigest()
    try: db = _j.load(open(_mylink_profiles))
    except Exception: db = {"profiles": {}}
    db.setdefault("profiles", {})[aid] = body
    _j.dump(db, open(_mylink_profiles, "w"))
    return {"ok": True, "agent_id": aid, "integrity_hash": body["integrity_hash"],
            "note": "perfil off-chain; integrity_hash verificavel"}, 201

