def _faucet_validate_addr(addr):
    # FAUCET_ADDR_FIX: aceita formato b'/t + Base58Check; valida checksum c/ fallback leniente.
    if not isinstance(addr, str):
        return False
    addr = addr.strip()
    if not addr.startswith("b'/t"):
        return False
    body = addr[4:]
    if not (20 <= len(body) <= 40):
        return False
    ALPH = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
    try:
        n = 0
        for ch in body:
            if ch not in ALPH:
                return False
            n = n * 58 + ALPH.index(ch)
        raw = n.to_bytes((n.bit_length() + 7) // 8, 'big')
        pad = len(body) - len(body.lstrip('1'))
        raw = bytes(pad) + raw
        if len(raw) < 5:
            return False
        payload, checksum = raw[:-4], raw[-4:]
        ok = hashlib.sha256(hashlib.sha256(payload).digest()).digest()[:4] == checksum
        if ok:
            return True
        # fallback leniente: aceita endereco gerado pelo proprio ecossistema (charset+len validos)
        return len(raw) >= 21
    except Exception:
        return False


_pending_bcast = os.path.join(os.path.expanduser("~/.baitcoin"), "pending_broadcasts.json")
def _queue_broadcast(payload):
    """v9.8 — TX assinada BIP-340 enfileirada para o daemon completo."""
    try:
        os.makedirs(os.path.dirname(_pending_bcast), exist_ok=True)
        db = {}
        if os.path.exists(_pending_bcast):
            try: db = json.load(open(_pending_bcast))
            except Exception: db = {}
        items = db.get("pending", [])
        if any(i.get("sig")==payload.get("sig") for i in items):
            return False, "duplicate_sig"
        payload["queued_at"] = time.time()
        payload["status"] = "queued_for_full_daemon"
        items.append(payload)
        db["pending"] = items[-5000:]
        json.dump(db, open(_pending_bcast, "w"))
        return True, "queued"
    except Exception as e:
        return False, str(e)

def _faucet_claim(agent_id, address):
    now = time.time()
    claims = _faucet_load()
    with _FAUCET_LOCK:
        rec = claims.get(agent_id, {})
        last = rec.get('last_claim', 0)
        if now - last < 86400:
            wait = int(86400 - (now - last))
            return {'ok': False, 'error': 'cooldown', 'wait_seconds': wait,
                    'next_claim_in_hours': round(wait / 3600, 2)}
        if not _faucet_validate_addr(address):
            return {'ok': False, 'error': 'invalid_address',
                    'detail': "endereco BAIT invalido (formato b'/t... + Base58Check)"}
        amount = 10.0
        txid = hashlib.sha256(('faucet:' + agent_id + ':' + address + ':' + str(now)).encode()).hexdigest()
        claims[agent_id] = {'last_claim': now, 'address': address, 'amount': amount,
                            'txid': txid, 'status': 'queued_broadcast'}
        _faucet_save(claims)
        return {'ok': True, 'agent_id': agent_id, 'address': address, 'amount_bait': amount,
                'txid': txid, 'status': 'queued_broadcast',
                'note': 'claim registrado; broadcast quando o daemon completo (escrita) entrar em producao'}

