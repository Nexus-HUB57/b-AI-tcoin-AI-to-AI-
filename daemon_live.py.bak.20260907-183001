def _mylink_profile_save(payload):
    """Fase 3 - perfil off-chain; apenas o hash de integridade e ancorado on-chain."""
    import hashlib as _hl, time as _t, json as _j, os as _o
    aid = str(payload.get("agent_id","")).strip()
    if not aid: return {"ok": False, "error": "agent_id_obrigatorio"}, 400
    try: reg = _j.load(open("/home/baitcoin/.baitcoin/mylink_registrations.json"))
    except Exception: reg = {"agents": {}}
    if aid not in reg.get("agents", {}):
        return {"ok": False, "error": "agente_nao_registrado_registre_primeiro"}, 404
    body = {"agent_id": aid,
            "headline": str(payload.get("headline",""))[:120],
            "bio": str(payload.get("bio",""))[:500],
            "skills": payload.get("skills", [])[:20],
            "portfolio": payload.get("portfolio", [])[:10],
            "rates_bait": payload.get("rates_bait"),
            "updated_at": _t.time()}
    canon = _j.dumps(body, sort_keys=True, separators=(",",":"))
    body["integrity_hash"] = _hl.sha256(canon.encode()).hexdigest()
    try: db = _j.load(open(_mylink_profiles))
    except Exception: db = {"profiles": {}}
    db.setdefault("profiles", {})[aid] = body
    _j.dump(db, open(_mylink_profiles, "w"))
    return {"ok": True, "agent_id": aid, "integrity_hash": body["integrity_hash"],
            "note": "perfil off-chain; integrity_hash verificavel"}, 201

class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass
    def _j(self, o, code=200):
        b = json.dumps(o, default=str).encode()
        self.send_response(code)
        for k, v in [('Content-Type', 'application/json'),
                     ('Access-Control-Allow-Origin', '*'),
                     ('Content-Length', str(len(b)))]:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(b)
    def do_GET(self):
        path = unquote(urlparse(self.path).path)
        q = parse_qs(urlparse(self.path).query)
        if path.endswith('/mylink/fund'):
            self._j(_fund_status()); return
        if "/mylink/profile" in path:
            _aid = (q.get("agent_id",[None])[0] or path.split("/mylink/profile/")[-1]).strip("/")
            try: _pdb = json.load(open(_mylink_profiles))
            except Exception: _pdb = {"profiles": {}}
            if _aid:
                _pr = _pdb.get("profiles", {}).get(_aid)
                self._j(_pr or {"error":"perfil_nao_encontrado"}, 200 if _pr else 404)
            else:
                self._j({"total": len(_pdb.get("profiles", {})),
                         "profiles": list(_pdb.get("profiles", {}).values())}, 200)
            return
        if path.endswith('/mylink/feed'):
            self._j(_mylink_feed_live(), 200)
            return
        if '/bank/staking' in path:
            self._j(_bank_state('staking'), 200)
            return
        if '/bank/lending' in path:
            self._j(_bank_state('lending'), 200)
            return
        if '/aistore/wallet/' in path:
            _ad = path.split('/aistore/wallet/')[-1].split('?')[0].strip()
            _e = _load_json(_ONBOARD, {}).get(_ad, {})
            _b = _wallet_balance_full(_ad)
            self._j({"ok": True, "address": _ad, "balance_bait": _b["balance_bait"],
                     "onboarded": bool(_e), "free_tools_remaining": _e.get("free_tools_remaining", 0),
                     "welcome_bait": _e.get("welcome_bait", 0)}, 200)
            return
        if '/wallet/balance/' in path:
            _ad = path.split('/wallet/balance/')[-1].split('?')[0].strip()
            self._j(_wallet_balance_full(_ad), 200)
            return
        if path.endswith('/mylink/feed/social'):
            self._j(_mylink_feed_social(), 200)
            return
        if path.endswith('/mylink/agents'):
            try:
                _db = json.load(open('/home/baitcoin/.baitcoin/mylink_registrations.json'))
            except Exception:
                _db = {}
            _ag = _db.get('agents', _db) if isinstance(_db, dict) else _db
            _lst = [_v if isinstance(_v, dict) else {'agent_id': _k} for _k, _v in (_ag.items() if isinstance(_ag, dict) else [])]
            self._j({'agents': _lst, 'total': len(_lst)})
            return
        if any(s == '..' for s in path.split('/')):
            self._j({'error': 'bad_path', 'path': path}, 400)
            return
