def _outs_with_addr(t):
    outs = []
    for o in (t.get('outputs') or []):
        spk = o.get('script_pubkey') or ''  # _v_f1_addr_nativo
        if not spk and o.get('address'):
            o = dict(o); o['address_resolved'] = o['address']
        addr = None
