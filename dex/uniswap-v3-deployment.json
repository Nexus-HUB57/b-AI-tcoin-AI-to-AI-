  "initialPrice": {
    "description": "Initial price for wBAIT/WETH pool",
    "pricePerBAITinUSD": 0.00111071,
    "pricePerBAITinETH": 0.000000555355,
    "assumption": "ETH = $2,000 at deployment time",
    "sqrtPriceX96": {
      "value": "2190640149935016301856",
      "description": "sqrtPriceX96 = sqrt(price) * 2^96 where price = token1/token0",
      "calculation": "sqrt(0.000000555355) * 2^96 = 2190640149935016301856",
      "note": "If WBAIT < WETH (address ordering), WBAIT is token0 and price = WETH/WBAIT"
    },
    "priceVerification": {
      "formula": "price = (sqrtPriceX96 / 2^96)^2",
      "inversePriceNote": "If WBAIT is token0: price = amount of WETH per 1 WBAIT. Actual BAIT price = 1/price if you want BAIT in terms of WETH."
    }
  },

