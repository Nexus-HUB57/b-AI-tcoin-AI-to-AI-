  "slippageProtection": {
    "description": "Minimum amounts for addLiquidity calls to prevent sandwich attacks",
    "defaultSlippageBps": 50,
    "defaultSlippagePct": "0.5%",
    "amount0Min": "amount0Desired * (10000 - slippageBps) / 10000",
    "amount1Min": "amount1Desired * (10000 - slippageBps) / 10000",
    "deadline": "block.timestamp + 300 (5 minutes)",
    "note": "The BAITUniswapV3Liquidity.sol contract currently uses amount0Min=0 and amount1Min=0. For production, consider overriding with slippage-protected values."
  },

  "deploymentSteps": [
    {
      "step": 1,
      "title": "Deploy WBAIT Token",
      "command": "forge script script/DeployBAIT.s.sol --rpc-url $RPC_URL --broadcast --verify",
      "verify": "Confirm totalSupply == 0 (no initial mint; bridge mints on lock)"
    },
    {
      "step": 2,
      "title": "Deploy BridgeLock",
      "command": "forge create BridgeLock --constructor-args $WBAIT_ADDRESS $OP0 $OP1 $OP2 $OP3 $OP4 --rpc-url $RPC_URL --verify",
      "verify": "Confirm all 5 operators registered"
    },
    {
      "step": 3,
      "title": "Deploy BAITUniswapV3Liquidity",
      "command": "forge create BAITUniswapV3Liquidity --constructor-args $WBAIT_ADDRESS $FACTORY $POSITION_MANAGER $WETH --rpc-url $RPC_URL --verify",
      "verify": "Confirm factory, positionManager, WETH addresses set"
    },
    {
      "step": 4,
      "title": "Create Uniswap V3 Pool",
      "command": "cast send $LIQUIDITY_ADDRESS 'createPool()' --rpc-url $RPC_URL --private-key $OWNER_KEY",
      "verify": "PoolCreated event emitted; pool address available via factory.getPool()"
    },
    {
      "step": 5,
      "title": "Add Initial Liquidity (Core Range)",
      "command": "cast send $LIQUIDITY_ADDRESS 'addLiquidity(uint256,uint256,int24,int24)' $AMT_WBAIT_CORE $AMT_WETH_CORE -207720 -205080 --rpc-url $RPC_URL --private-key $OWNER_KEY",
      "verify": "LiquidityAdded event emitted; position tokenId recorded"
    },
    {
      "step": 6,
      "title": "Add Liquidity (Wide Range)",
      "command": "cast send $LIQUIDITY_ADDRESS 'addLiquidity(uint256,uint256,int24,int24)' $AMT_WBAIT_WIDE $AMT_WETH_WIDE -215700 -197100 --rpc-url $RPC_URL --private-key $OWNER_KEY",
      "verify": "LiquidityAdded event emitted"
    },
    {
      "step": 7,
      "title": "Add Liquidity (Safety Range)",
      "command": "cast send $LIQUIDITY_ADDRESS 'addLiquidity(uint256,uint256,int24,int24)' $AMT_WBAIT_SAFETY $AMT_WETH_SAFETY -230400 -184200 --rpc-url $RPC_URL --private-key $OWNER_KEY",
      "verify": "LiquidityAdded event emitted"
    },
    {
      "step": 8,
      "title": "Verify Pool on Etherscan",
      "command": "forge verify-contract $POOL_ADDRESS UniswapV3Pool --chain-id 1 --watch",
      "verify": "Contract verified on Etherscan"
    },
    {
      "step": 9,
      "title": "Start DEX Monitoring",
      "command": "POOL_ADDRESS=$POOL_ADDRESS python3 dex/dex-monitoring.py &",
      "verify": "Monitor running and reporting pool state"
    }
  ],

  "forgeScriptCommands": {
    "createPool": "cast send $LIQUIDITY_ADDRESS 'createPool()' --rpc-url $RPC_URL --private-key $OWNER_KEY",
    "addLiquidityCore": "cast send $LIQUIDITY_ADDRESS 'addLiquidity(uint256,uint256,int24,int24)' 2250000000000000 27500000000000000000 -207720 -205080 --rpc-url $RPC_URL --private-key $OWNER_KEY",
    "addLiquidityWide": "cast send $LIQUIDITY_ADDRESS 'addLiquidity(uint256,uint256,int24,int24)' 1350000000000000 16500000000000000000 -215700 -197100 --rpc-url $RPC_URL --private-key $OWNER_KEY",
    "addLiquiditySafety": "cast send $LIQUIDITY_ADDRESS 'addLiquidity(uint256,uint256,int24,int24)' 900000000000000 11000000000000000000 -230400 -184200 --rpc-url $RPC_URL --private-key $OWNER_KEY",
    "checkPool": "cast call $FACTORY_ADDRESS 'getPool(address,address,uint24)(address)' $WBAIT_ADDRESS $WETH_ADDRESS 3000 --rpc-url $RPC_URL",
    "getSlot0": "cast call $POOL_ADDRESS 'slot0()(uint160,int24,uint16,uint16,uint16,uint8,bool)' --rpc-url $RPC_URL",
    "getLiquidity": "cast call $POOL_ADDRESS 'liquidity()(uint128)' --rpc-url $RPC_URL",
    "getTickSpacing": "cast call $POOL_ADDRESS 'tickSpacing()(int24)' --rpc-url $RPC_URL"
  },

  "monitoring": {
    "freeRPCEndpoints": [
      "https://eth.drpc.org",
      "https://rpc.ankr.com/eth",
      "https://ethereum.publicnode.com",
      "https://1rpc.io/eth"
    ],
    "recommendedPollInterval": "30 seconds",
    "largeSwapAlertThreshold": "$10,000 USD",
    "priceDeviationAlert": "10% from initial price",
    "monitoringScript": "dex/dex-monitoring.py",
    "bootstrappingScript": "dex/liquidity-bootstrapping.py"
  }
