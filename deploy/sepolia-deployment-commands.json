      "estimated_time": "1 min"
    },
    {
      "step": 5,
      "description": "Deploy WBAIT + BridgeLock to Sepolia",
      "command": "forge script script/DeployBAIT.s.sol --rpc-url $SEPOLIA_RPC_URL --broadcast --verify",
