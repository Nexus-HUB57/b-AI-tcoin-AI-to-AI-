  "anvil": {
    "description": "Foundry Anvil local development chain",
    "url": "http://127.0.0.1:8545",
    "startCommand": "anvil --host 127.0.0.1 --port 8545 --chain-id 31337",
    "features": [
      "Pre-funded with 10,000 ETH per default account",
      "Instant block mining",
      "Full EVM compatibility",
      "Fork mainnet capability: anvil --fork-url <RPC_URL>",
      "Mempool inspection and manipulation",
      "Auto-mining and interval mining modes"
    ],
    "preFundedAccounts": 10,
    "preFundedEthPerAccount": 10000,
    "chainId": 31337,
    "networkId": 31337
