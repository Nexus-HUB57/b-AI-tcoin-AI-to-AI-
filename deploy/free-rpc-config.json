  "rpcValidationScript": {
    "path": "deploy/validate-free-rpc.sh",
    "description": "Bash script that tests each free RPC endpoint with eth_blockNumber, measures latency, and outputs JSON results",
    "usage": "bash deploy/validate-free-rpc.sh",
    "outputFile": "deploy/free-rpc-validation-results.json"
  },

  "deploymentConfig": {
    "foundryConfig": {
      "setRpcCommand": "export ETH_RPC_URL=<CHOSEN_RPC_URL>",
      "anvilCommand": "anvil",
      "deployToAnvil": "forge script script/Deploy.s.sol --rpc-url http://127.0.0.1:8545 --broadcast",
      "deployToSepolia": "forge script script/Deploy.s.sol --rpc-url https://1rpc.io/sepolia --broadcast --verify",
      "deployToMainnet": "forge script script/Deploy.s.sol --rpc-url https://1rpc.io/eth --broadcast --verify"
    },
    "recommendedWorkflow": [
      "1. Validate RPC endpoints: bash deploy/validate-free-rpc.sh",
      "2. Deploy to Anvil first (free, instant): forge script ... --rpc-url http://127.0.0.1:8545 --broadcast",
      "3. Deploy to Sepolia (free testnet ETH): forge script ... --rpc-url <SEPOLIA_RPC> --broadcast --verify",
      "4. Deploy to Mainnet (requires real ETH): forge script ... --rpc-url <MAINNET_RPC> --broadcast --verify"
    ]
  }
