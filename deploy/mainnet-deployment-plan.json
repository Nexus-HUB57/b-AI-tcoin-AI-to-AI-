  "emergency_rollback_procedures": {
    "description": "If a critical issue is discovered post-deployment, follow these procedures IN ORDER.",
    "severity_levels": {
      "CRITICAL": "Immediate pause + assess. Example: unauthorized minting, bridge exploit.",
      "HIGH": "Pause within 1 hour + assess. Example: incorrect operator configuration.",
      "MEDIUM": "Assess within 24h + plan fix. Example: suboptimal gas, minor config issue."
    },
    "procedures": [
      {
        "step": 1,
        "name": "Emergency Pause",
        "description": "Pause all WBAIT transfers and BridgeLock operations immediately.",
        "commands": [
          "cast send <WBAIT_ADDR> 'pause()' --rpc-url $MAINNET_RPC_URL --private-key $OWNER_KEY",
          "cast send <BRIDGE_ADDR> 'pause()' --rpc-url $MAINNET_RPC_URL --private-key $OWNER_KEY"
        ],
        "gas_estimate": "~70,000 gas each (~0.002 ETH at 30 gwei)",
        "note": "If ownership has been transferred to multisig, execute via Gnosis Safe."
      },
      {
        "step": 2,
        "name": "Assess Impact",
        "description": "Determine the scope of the issue. Check totalSupply, recent events, operator status.",
        "commands": [
          "cast call <WBAIT_ADDR> 'totalSupply()(uint256)'",
          "cast call <WBAIT_ADDR> 'paused()(bool)'",
          "cast call <BRIDGE_ADDR> 'paused()(bool)'",
          "cast call <BRIDGE_ADDR> 'getLockRequestCount()(uint256)'",
          "cast call <BRIDGE_ADDR> 'getBurnReleaseCount()(uint256)'"
        ]
      },
      {
        "step": 3,
        "name": "Operator Rotation",
        "description": "If an operator key is compromised, use the timelock process to replace it.",
        "note": "Requires 24h timelock. Plan operator rotation immediately after compromise detection."
      },
      {
        "step": 4,
        "name": "Full Rollback (Last Resort)",
        "description": "If the deployment is fundamentally flawed, pause all contracts and deploy new versions. Users must manually migrate.",
        "steps": [
          "1. Pause all current contracts",
          "2. Deploy new WBAIT (v2) with correct BridgeLock address",
          "3. Deploy new BridgeLock (v2) with correct operators",
          "4. Announce migration plan",
          "5. Users burn wBAIT(v1) and re-lock on L1 to receive wBAIT(v2)",
          "6. Verify new deployment",
          "7. Unpause new contracts"
        ],
        "note": "Full rollback is EXTREMELY expensive and disruptive. Only consider for critical flaws."
      }
    ],
    "contacts": {
